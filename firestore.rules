rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    match /books/{bookId} {
      // Cho phép đọc danh sách sách của user đang đăng nhập
      allow read: if isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid);

      // Cho phép thêm mới sách thuộc về user đang đăng nhập
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;

      // Cho phép sửa sách của chính mình
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;

      // Cho phép xóa sách của chính mình
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
  }
}
